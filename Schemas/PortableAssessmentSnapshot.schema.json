{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/entra-application-exposure-analyzer/portable-assessment-snapshot.schema.json",
  "title": "Entra App Exposure Portable Assessment Snapshot",
  "type": "object",
  "required": [
    "SchemaVersion",
    "SnapshotId",
    "CollectedAtUtc",
    "Assessment",
    "Collection",
    "Applications",
    "ServicePrincipals",
    "Observations"
  ],
  "properties": {
    "SchemaVersion": {
      "const": "2.1"
    },
    "SnapshotId": {
      "type": "string",
      "minLength": 1
    },
    "CollectedAtUtc": {
      "type": "string",
      "minLength": 1
    },
    "Assessment": {
      "type": "object"
    },
    "Collection": {
      "type": "object"
    },
    "Applications": {
      "type": "array"
    },
    "ServicePrincipals": {
      "type": "array"
    },
    "Observations": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
