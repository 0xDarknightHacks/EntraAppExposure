{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/0xDarknightHacks/EntraAppExposure/Schemas/RulePack.schema.json",
  "title": "Entra App Exposure rule baseline",
  "type": "object",
  "required": [
    "SchemaVersion",
    "BaselineVersion",
    "Name",
    "Policy",
    "Definitions"
  ],
  "properties": {
    "SchemaVersion": {
      "const": "2.1"
    },
    "BaselineVersion": {
      "type": "string",
      "minLength": 1
    },
    "Name": {
      "type": "string",
      "minLength": 1
    },
    "Policy": {
      "type": "object",
      "required": [
        "Credential",
        "Ownership",
        "Activity",
        "SensitiveApplicationPermissions",
        "SensitiveDelegatedPermissions"
      ],
      "properties": {
        "Credential": {
          "type": "object",
          "required": [
            "LongLivedDays",
            "ExpiringSoonDays",
            "MaxActiveCredentials"
          ],
          "properties": {
            "LongLivedDays": {
              "type": "integer",
              "minimum": 1
            },
            "ExpiringSoonDays": {
              "type": "integer",
              "minimum": 1
            },
            "MaxActiveCredentials": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "Ownership": {
          "type": "object",
          "required": [
            "MinimumOwners"
          ],
          "properties": {
            "MinimumOwners": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "SensitiveApplicationPermissions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ResourceAppId",
              "PermissionValue"
            ],
            "properties": {
              "ResourceAppId": {
                "type": "string",
                "minLength": 1
              },
              "PermissionValue": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        "SensitiveDelegatedPermissions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ResourceAppId",
              "PermissionValue"
            ],
            "properties": {
              "ResourceAppId": {
                "type": "string",
                "minLength": 1
              },
              "PermissionValue": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        "Activity": {
          "type": "object",
          "required": [
            "MinimumReviewLookbackDays",
            "MinimumIdentityAgeDays",
            "ExcludeMicrosoftFirstParty",
            "ExcludedServicePrincipalTypes"
          ],
          "properties": {
            "MinimumReviewLookbackDays": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90
            },
            "MinimumIdentityAgeDays": {
              "type": "integer",
              "minimum": 0
            },
            "ExcludeMicrosoftFirstParty": {
              "type": "boolean"
            },
            "ExcludedServicePrincipalTypes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "Definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "Id",
          "Enabled",
          "Category",
          "Severity",
          "AppliesTo",
          "Title",
          "Rationale",
          "Recommendation",
          "RequiredEvidence",
          "References"
        ],
        "properties": {
          "Id": {
            "type": "string",
            "pattern": "^EAE-[A-Z]+(?:-[A-Z]+)*-[0-9]{3}$"
          },
          "Enabled": {
            "type": "boolean"
          },
          "Category": {
            "type": "string",
            "minLength": 1
          },
          "Severity": {
            "enum": [
              "High",
              "Medium",
              "Low",
              "Informational"
            ]
          },
          "AppliesTo": {
            "enum": [
              "ApplicationRegistration",
              "ServicePrincipal"
            ]
          },
          "Title": {
            "type": "string",
            "minLength": 1
          },
          "Rationale": {
            "type": "string",
            "minLength": 1
          },
          "Recommendation": {
            "type": "string",
            "minLength": 1
          },
          "RequiredEvidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "References": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
